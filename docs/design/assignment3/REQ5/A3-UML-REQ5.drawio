        <mxCell id="RsX68DpZdRlASR3TYmVj-23" parent="cwCSX3bzDBXSD4CKaSsB-1" style="shape=note;strokeWidth=2;fontSize=15;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;verticalAlign=middle;" value="&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;The colour grouping reflects the five major design components of REQ1:&lt;br&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;1.&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Purple = Access card purchase system&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;2.&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Yellow = General buying pipeline&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;3.&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Blue = Selling/scrap pipeline&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;4.&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Red = Actor economy (credits, inventory)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;5.&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Green = Transaction side-effects&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;This visual separation makes it easier to trace how each requirement feature flows through the system; &lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; from catalogue (purple/yellow/blue) --&amp;gt; actions (yellow/blue) --&amp;gt; items (yellow/blue) --&amp;gt; effects (green) --&amp;gt; actors (red)&lt;/div&gt;" vertex="1">
          <mxGeometry height="204" width="871" x="57" y="134" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml REQ5_ToxicAtmosphere\ntitle FIT2099 Assignment 3 - REQ5 Class Diagram (A.P.I — Toxic Atmosphere)\n\nskinparam classAttributeIconSize 0\nskinparam classFontStyle bold\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam ArrowFontSize 10\nskinparam classBackgroundColor #FFFFFF\nskinparam packageBackgroundColor #FFFFFF\nskinparam nodesep 55\nskinparam ranksep 70\nskinparam linetype ortho\nhide members\nhide circle\ntop to bottom direction\n\n&#39; ============================================================\n&#39; ENGINE (existing — do not modify)\n&#39; ============================================================\npackage \&quot;edu.monash.fit2099.engine\&quot; #E6F5E6 {\n    package \&quot;actions\&quot; #DCEEFA {\n        class Action     &lt;&lt;abstract&gt;&gt;\n    }\n    package \&quot;behaviours\&quot; #DCEEFA {\n        interface Behaviour &lt;&lt;interface&gt;&gt;\n    }\n    package \&quot;actors\&quot; #DCEEFA {\n        class Actor      &lt;&lt;abstract&gt;&gt;\n    }\n    package \&quot;positions\&quot; #DCEEFA {\n        class GameMap\n        class Location\n    }\n}\n\n&#39; ============================================================\n&#39; GAME (existing — REQ1/REQ2 classes the corruptors touch)\n&#39; ============================================================\npackage \&quot;game\&quot; #FFF6E0 {\n    class Application\n    package \&quot;locations\&quot; #F2E8FA {\n        class EclipseNebula\n    }\n    package \&quot;actors\&quot; #F2E8FA {\n        class EclipseActor      &lt;&lt;abstract&gt;&gt;\n        class ContractedWorker\n        enum  EclipseStatistics &lt;&lt;enum&gt;&gt;\n    }\n    package \&quot;grounds\&quot; #F2E8FA {\n        class SuperComputer\n    }\n    package \&quot;items\&quot; #F2E8FA {\n        interface Sellable &lt;&lt;interface&gt;&gt;\n        class     Fire\n    }\n    package \&quot;statuses\&quot; #F2E8FA {\n        class PoisonStatus\n    }\n\n    &#39; ============================================================\n    &#39; GAME.ATMOSPHERE (NEW — all REQ5 classes)\n    &#39; ============================================================\n    package \&quot;atmosphere\&quot; #FDE7D6 {\n        interface PollutionDataParser  &lt;&lt;interface&gt;&gt;\n        interface AtmosphericCorruptor &lt;&lt;interface&gt;&gt;\n        interface AtmosphereSensitiveActor &lt;&lt;interface&gt;&gt;\n\n        class OpenWeatherPollutionParser\n        class AirQualityReport\n        class HazardCorruptor\n        class EconomyCorruptor\n\n        class AtmosphericApiClient\n        class AtmosphericServicesFactory\n        class AtmosphericScanAction\n        class EnvironmentalMonitorBehaviour\n        class AtmosphericMonitor\n    }\n}\n\n&#39; ============================================================\n&#39; INHERITANCE  ( -|&gt;  solid, hollow triangle )\n&#39; ============================================================\nAtmosphericScanAction          --|&gt; Action\nAtmosphericMonitor             --|&gt; EclipseActor\n\n&#39; ============================================================\n&#39; REALISATION  ( ..|&gt;  dashed, hollow triangle )\n&#39; ============================================================\nOpenWeatherPollutionParser     ..|&gt; PollutionDataParser\nHazardCorruptor                ..|&gt; AtmosphericCorruptor\nEconomyCorruptor               ..|&gt; AtmosphericCorruptor\nEnvironmentalMonitorBehaviour  ..|&gt; Behaviour\nContractedWorker               ..|&gt; AtmosphereSensitiveActor\n\n&#39; ============================================================\n&#39; ASSOCIATION  ( --&gt;  field-based, multiplicity )\n&#39; ============================================================\nAtmosphericScanAction          \&quot;1\&quot; --&gt; \&quot;1\&quot;  PollutionDataParser\nAtmosphericScanAction          \&quot;1\&quot; --&gt; \&quot;*\&quot;  AtmosphericCorruptor\nAtmosphericScanAction          \&quot;1\&quot; --&gt; \&quot;1\&quot;  AtmosphericApiClient\nEnvironmentalMonitorBehaviour  \&quot;1\&quot; --&gt; \&quot;1\&quot;  PollutionDataParser\nEnvironmentalMonitorBehaviour  \&quot;1\&quot; --&gt; \&quot;*\&quot;  AtmosphericCorruptor\nAtmosphericMonitor             \&quot;1\&quot; --&gt; \&quot;1\&quot;  EnvironmentalMonitorBehaviour\n\n&#39; ============================================================\n&#39; DEPENDENCY  ( ..&gt;  uses / creates / mutates / parses-into )\n&#39; ============================================================\nPollutionDataParser            ..&gt; AirQualityReport      : parses into\nAtmosphericCorruptor           ..&gt; AirQualityReport      : reads\nAtmosphericCorruptor           ..&gt; GameMap               : mutates\n\nHazardCorruptor                ..&gt; AtmosphereSensitiveActor : applies AQI effects to\nHazardCorruptor                ..&gt; PoisonStatus          : creates status\n\nEconomyCorruptor               ..&gt; EclipseStatistics     : mutates credits\nEconomyCorruptor               ..&gt; Sellable              : (game economy)\n\nAtmosphericServicesFactory     ..&gt; OpenWeatherPollutionParser : creates\nAtmosphericServicesFactory     ..&gt; HazardCorruptor             : creates\nAtmosphericServicesFactory     ..&gt; EconomyCorruptor            : creates\n\nAtmosphericScanAction          ..&gt; AtmosphericServicesFactory : uses\nAtmosphericApiClient           ..&gt; AirQualityReport       : returns JSON for\n\n&#39; World wiring\nEclipseNebula                  ..&gt; AtmosphericMonitor          : places\nEclipseNebula                  ..&gt; AtmosphericServicesFactory  : configures\nApplication                    ..&gt; EclipseNebula               : boots\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="lI0fjlXdN1tP_MhAhEo4-1">
          <mxCell parent="cwCSX3bzDBXSD4CKaSsB-1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="946" width="2699" x="2371" y="134" as="geometry" />
          </mxCell>
        </UserObject>
