<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="CHfEYuhwMQeLdT7HDoR1">
    <mxGraphModel dx="2516" dy="951" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam style strictuml\nskinparam sequenceMessageAlign center\nskinparam SequenceArrowThickness 1.5\nskinparam ArrowColor #000000\nskinparam SequenceReturnStyle line\n\nactor \&quot;Game Engine\&quot; as Engine\nparticipant \&quot;:StatefulCreature\\n(PhantasmWisp)\&quot; as Creature\nparticipant \&quot;:TinkerState\&quot; as Tink\nparticipant \&quot;:GameMap\&quot; as Map\nparticipant \&quot;:Location\&quot; as Loc\nparticipant \&quot;:Fire\&quot; as FireObj\n\nnote right of Tink #FFFF99\n  This sequence diagram represents\n  TinkerState, which handles the\n  PhantasmWisp&#39;s CURIOUS emotion.\n  The state transitions based on\n  nearby workers and spawns Fire\n  around the nearest worker when\n  entering this state.\nend note\n\nEngine -&gt; Creature : playTurn(actions, lastAction, map, display)\nactivate Creature\n\n    Creature -&gt; Creature : getCurrentState()\n    Creature --&gt;&gt; Creature : currentState\n\n    Creature -&gt; Tink : transition(actor, map)\n    activate Tink\n\n        Tink -&gt; Tink : workerNumber(vigilanceRange, location)\n        Tink --&gt;&gt; Tink : workerCount\n\n        Tink -&gt; Tink : workerDetection(SURROUNDING, location)\n        Tink --&gt;&gt; Tink : adjacentWorkerFound\n\n        alt workerCount == ONE_WORKER &amp;&amp; !adjacentWorkerFound\n            Tink --&gt;&gt; Creature : Emotion.CAUTION\n        else workerCount == TWO_WORKER\n            Tink --&gt;&gt; Creature : Emotion.FEARFUL\n        else !workerDetection(vigilanceRange, location)\n            Tink --&gt;&gt; Creature : Emotion.MISCHIEVOUS\n        else\n            Tink --&gt;&gt; Creature : Emotion.CURIOUS\n        end\n\n    deactivate Tink\n\n    alt newEmotion != currentEmotion\n        Creature -&gt; Creature : currentEmotion = newEmotion\n        Creature -&gt; Creature : getCurrentState()\n        Creature --&gt;&gt; Creature : currentState (new)\n\n        Creature -&gt; Tink : immediateEffect(location)\n        activate Tink\n\n            Tink -&gt; Tink : nearestWorker(vigilanceRange, location)\n            activate Tink\n                Tink -&gt; Tink : workerTargeted(vigilanceRange, location)\n                Tink --&gt;&gt; Tink : targetedWorkers\n            deactivate Tink\n            Tink --&gt;&gt; Tink : nearest\n\n            Tink -&gt; Map : locationOf(nearest)\n            activate Map\n            Map --&gt;&gt; Tink : workerLocation\n            deactivate Map\n\n            Tink -&gt; Loc : getNearbyLocations(SURROUNDING)\n            activate Loc\n            Loc --&gt;&gt; Tink : adjacentLocations\n            deactivate Loc\n\n            loop for each here in adjacentLocations\n                Tink -&gt; FireObj ** : new Fire(3)\n                Tink -&gt; Loc : addItem(fire)\n                activate Loc\n                Loc --&gt;&gt; Tink : void\n                deactivate Loc\n            end\n\n        Tink --&gt;&gt; Creature : void\n        deactivate Tink\n    end\n\n    Creature -&gt; Tink : stateBehaviourAction()\n    activate Tink\n    Tink --&gt;&gt; Creature : behaviours (List&lt;Behaviour&gt;)\n    deactivate Tink\n\n    loop for each behaviour in behaviours\n        Creature -&gt; Creature : behaviour.operate(this, location)\n        Creature --&gt;&gt; Creature : action\n\n        alt action != null\n            Creature --&gt;&gt; Engine : action\n        end\n    end\n\ndeactivate Creature\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="fVAbsLE3pK6fHKsX5GB3-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1078.72" width="799" x="-822" y="50" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
